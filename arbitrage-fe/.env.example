# Default selected network when URL has no ?network=... parameter.
VITE_DEFAULT_NETWORK=devnet

# Optional override for devnet contract address.
# If omitted, value is read from ../arbitrage-sc/interactor/state.toml.
# VITE_DEVNET_CONTRACT_ADDRESS=erd1...

# Required only if you want to load mainnet data.
# Without this, switching to mainnet will show an error.
VITE_MAINNET_CONTRACT_ADDRESS=
